# PostHog (server-side analytics for the automated upgrade flow).
# Set these in the trigger.dev cloud env. Use the SAME PostHog project as the
# dashboard/marketing so events attribute to the same teams/people.
POST_HOG_API_KEY=
POST_HOG_API_HOST=

# Loops (transactional emails for usage limits/warnings).
LOOPS_API_KEY=
# The subscription_alert email ("your subscription has been updated") — a
# NEW template, deliberately under a new var name so it can coexist in the
# env with the old code's LOOPS_USAGE_UPGRADE_TRANSACTIONAL_EMAIL_ID while
# this is in review/rollout.
LOOPS_SUBSCRIPTION_ALERT_TRANSACTIONAL_EMAIL_ID=
# Shared across the 80/90/95% warnings — the crossed threshold is sent as
# threshold_percent/usage_percent data so the template branches on it.
LOOPS_USAGE_THRESHOLD_TRANSACTIONAL_EMAIL_ID=

# TEMPORARY (delete once every date has passed): teams promised under the
# old upgrade system that they would NOT be auto-upgraded. Exempt from the
# entire usage-limits system strictly before the given date — no 80/90/95%
# warnings, no automatic subscription updates, no emails (they already got
# alerts under the old system). Format: <team_id>:<date>, comma-separated, where
# <date> is YYYY-MM-DD (UTC midnight) or a full ISO timestamp with offset.
# e.g. USAGE_UPGRADE_EXEMPTIONS=team_abc:2027-01-01,team_def:2026-12-01T00:00:00-05:00
USAGE_UPGRADE_EXEMPTIONS=
