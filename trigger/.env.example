# R2 media storage. Set these locally and in each Trigger.dev cloud environment.
# Use bucket-scoped object read/write credentials and a production public custom domain.
# See R2_MEDIA_STORAGE.md, especially TikTok URL-prefix verification before rollout.
R2_ENDPOINT= # https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=post-media
# Maps to the bucket root; do not append the bucket name. Optional path prefix supported.
R2_PUBLIC_BASE_URL= # https://media.example.com
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are still required for database access.
# Non-system standard TikTok projects also copy final media to Supabase post-media.
# Facebook video Stories and Reels use the same copy task for all projects.
# Optional public prefix override if SUPABASE_URL differs from the verified legacy host.
# Defaults to ${SUPABASE_URL}/storage/v1/object/public/post-media.
SUPABASE_MEDIA_PUBLIC_BASE_URL= # https://data.postforme.dev/storage/v1/object/public/post-media
# Existing Supabase cleanup is unchanged and does not remove R2 objects.
# Configure R2 lifecycle cleanup for abandoned multipart uploads, not blanket object expiry.

# REQUIRED for live media processing. Missing configuration fails media processing;
# it does not select the legacy pipeline. Set locally and in each Trigger environment.
# Use the Redis instance/database the media workers consume (redis:// or rediss://).
# Live artifacts are retained under publishing/. No artifact deletion; see MEDIA_SERVER.md.
MEDIA_SERVER_REDIS_URL=

# PostHog (server-side analytics for the automated upgrade flow).
# Set these in the trigger.dev cloud env. Use the SAME PostHog project as the
# dashboard/marketing so events attribute to the same teams/people.
POST_HOG_API_KEY=
POST_HOG_API_HOST=

# Facebook / Instagram Graph API overrides used by
# posting/platforms/facebook-post-client.ts and instagram-post-client.ts.
# All optional; each falls back to the default shown if unset.
FACEBOOK_GRAPH_API_URL= # default: https://graph.facebook.com
FACEBOOK_GRAPH_VIDEO_API_URL= # default: https://graph-video.facebook.com
INSTAGRAM_GRAPH_API_URL= # default: https://graph.instagram.com
FACEBOOK_API_VERSION= # default: v25.0
INSTAGRAM_API_VERSION= # default: v23.0
FACEBOOK_OAUTH_API_VERSION= # default: v20.0

# Loops (transactional emails for usage limits/warnings).
LOOPS_API_KEY=
# The subscription_alert email ("your subscription has been updated") — a
# NEW template, deliberately under a new var name so it can coexist in the
# env with the old code's LOOPS_USAGE_UPGRADE_TRANSACTIONAL_EMAIL_ID while
# this is in review/rollout.
LOOPS_SUBSCRIPTION_ALERT_TRANSACTIONAL_EMAIL_ID=
# Shared across the 80/90/95% warnings — the crossed threshold is sent as
# threshold_percent/usage_percent data so the template branches on it.
LOOPS_USAGE_THRESHOLD_TRANSACTIONAL_EMAIL_ID=

# Optional LinkedIn API version override. Defaults to 202601 when unset.
# Kept in sync manually with api/'s LINKEDIN_API_VERSION.
LINKEDIN_API_VERSION=

# TEMPORARY (delete once every date has passed): teams promised under the
# old upgrade system that they would NOT be auto-upgraded. Exempt from the
# entire usage-limits system strictly before the given date — no 80/90/95%
# warnings, no automatic subscription updates, no emails (they already got
# alerts under the old system). Format: <team_id>:<date>, comma-separated, where
# <date> is YYYY-MM-DD (UTC midnight) or a full ISO timestamp with offset.
# e.g. USAGE_UPGRADE_EXEMPTIONS=team_abc:2027-01-01,team_def:2026-12-01T00:00:00-05:00
USAGE_UPGRADE_EXEMPTIONS=
