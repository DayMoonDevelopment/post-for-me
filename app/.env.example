# Supabase — server-side auth (@supabase/ssr owns the auth cookies). No VITE_
# prefix: Supabase is used server-side only, so these never reach the bundle.
# Find both under Project Settings → API. The publishable ("anon") key is safe
# to send to clients in general, but we keep it server-side here regardless.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Service-role secret — bypasses RLS, carries no session. Used ONLY by the
# session-less server ops: the public OAuth callbacks and the Stripe webhook
# (see below). Server-only; never expose it to the bundle.
SUPABASE_SERVICE_ROLE_KEY=

# PostHog — project API key (phc_...). VITE_ prefix exposes these to the
# client bundle; the same vars are read server-side by posthog-node.
# Leave empty to disable analytics entirely (e.g. local dev).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Stripe — server-side only (creating Checkout / billing-portal sessions and
# reading product/subscription state for the billing step). Leave empty to
# disable the billing step locally.
STRIPE_SECRET_KEY=

# Stripe webhooks. Each one is a SEPARATE Stripe endpoint with a single purpose,
# a single outcome, and therefore its own signing secret:
#   /webhook/stripe/subscription-access — revoke/restore a team's API keys as its
#     subscription changes (interim churn protection; see
#     app/lib/.server/subscription-access/README.md).
#   /webhook/stripe/customer-link — bind a Stripe customer to its team
#     (teams.stripe_customer_id) for customers not created via Checkout.
# Everything else Stripe sends is the API's. Leave empty locally; an endpoint
# 500s without its secret rather than silently no-op'ing.
STRIPE_WEBHOOK_SECRET_SUBSCRIPTION_ACCESS=
STRIPE_WEBHOOK_SECRET_CUSTOMER_LINK=

# Post For Me API — the real API the dashboard proxies user actions to (webhooks
# now; more entities later). The dashboard mints a short-lived per-project key
# (see Unkey below) and calls the API as the user. Override for local API dev;
# defaults to production.
API_URL=https://api.postforme.dev

# Unkey — server-side only. One Unkey API namespace holds every project's keys,
# partitioned by externalId=projectId, split by prefix: `pfm_tmp` (short-lived
# dashboard keys minted to call the API) + `pfm_live` (the user's own API keys).
# UNKEY_ROOT_KEY is a workspace root key; UNKEY_API_ID is the API namespace id.
# Leave empty to disable the keys backend (pages show an "unavailable" notice).
UNKEY_ROOT_KEY=
UNKEY_API_ID=

# Ad pixels (browser). VITE_ prefix exposes them to the bundle. Optional —
# omit to skip the pixel. Conversions are sent via PostHog destinations, not
# these pixels; the pixels only set _fbc/_fbp and fire PageView for match quality.
VITE_META_PIXEL_ID=
VITE_GOOGLE_ADS_TAG_ID=
