{
  "name": "@post-for-me/app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "NODE_ENV=development react-router typegen && tsc",
    "lint": "eslint app e2e playwright.config.ts",
    "lint:fix": "eslint app e2e playwright.config.ts --fix",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "E2E_SLOWMO=300 playwright test --headed --workers=1",
    "test:e2e:debug": "playwright test --debug",
    "stripe:webhook": "trap 'kill 0' INT TERM; stripe listen --forward-to https://app.postforme.foo/webhook/stripe/subscription-access --events customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,customer.subscription.paused,customer.subscription.resumed,invoice.paid,invoice.payment_failed & stripe listen --forward-to https://app.postforme.foo/webhook/stripe/customer-link --events customer.created,customer.updated & wait",
    "stripe:webhook:secret": "stripe listen --print-secret",
    "stripe:forward": "NODE_EXTRA_CA_CERTS=\"$HOME/Library/Application Support/Caddy/pki/authorities/local/root.crt\" bun run scripts/webhook-forward.ts",
    "test:fixture": "bun run scripts/webhook-fixture.ts",
    "test:fixture:reset": "bun run scripts/webhook-fixture.ts --reset",
    "test:state": "bun run scripts/webhook-state.ts",
    "seed:billing": "bun run scripts/billing-seed.ts",
    "seed:billing:reset": "bun run scripts/billing-seed.ts --reset",
    "verify:billing": "bun run scripts/billing-verify.ts",
    "stripe:portal": "bun run scripts/stripe-portal-config.ts",
    "stripe:portal:apply": "bun run scripts/stripe-portal-config.ts --apply"
  },
  "dependencies": {
    "@atproto/api": "^0.18.3",
    "@base-ui/react": "^1.6.0",
    "@central-icons/filled": "^1.1.286",
    "@central-icons/outlined": "^1.1.286",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource/dm-mono": "^5.3.0",
    "@react-router/fs-routes": "^8.2.0",
    "@react-router/node": "8.2.0",
    "@react-router/serve": "8.2.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@tanstack/react-table": "^9.1.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@unkey/api": "^2.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "googleapis": "^166.0.0",
    "i18next": "^26.3.1",
    "input-otp": "^1.4.2",
    "isbot": "^5.1.36",
    "motion": "^12.40.0",
    "post-for-me": "^2.7.0",
    "posthog-js": "^1.386.0",
    "posthog-node": "^5.36.14",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-router": "8.2.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "stripe": "^22.2.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "twitter-api-v2": "^1.28.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@react-router/dev": "8.2.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.2.1",
    "eslint": "^10.5.0",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-react": "^7.37.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.3"
  }
}
